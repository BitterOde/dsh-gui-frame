      "loggerMarkerOnStderr": false,
      "stderrMarkerOnStderr": true,
      "stderrMarkerOnStdout": false
    },
    "inherit": {
      "exitCode": 0,
      "note": "子进程 stderr 直落本探针进程 stderr，见本次命令输出里的哨兵行"
