{
  "markers": {
    "MARK_LOG": "[gui-frame] logger-marker-P2",
    "MARK_ERR": "[gui-frame] 客户端失败 stderr-marker-P2"
  },
  "findings": {
    "pipe": {
      "exitCode": 0,
      "childStdout": "P2-CHILD {\"exporters\":1,\"bufferLen\":2,\"bufferTypes\":[\"error:0\",\"info:1\"],\"errorHitsBuffer\":true,\"infoHitsBuffer\":true,\"warnHitsBuffer\":false,\"debugHitsBuffer\":false,\"loggerLevel\":null,\"loggerName\":\"root\"}\n",
      "childStderr": "[gui-frame] 客户端失败 stderr-marker-P2\n",
